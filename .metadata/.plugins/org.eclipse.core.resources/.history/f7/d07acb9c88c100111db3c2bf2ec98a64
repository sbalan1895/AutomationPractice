package com.pomutkadmin;

import java.time.Duration;

import org.jspecify.annotations.NonNull;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.Select;
import org.openqa.selenium.support.ui.WebDriverWait;

public class POM_CandRegister {

	WebDriver driver;
	WebDriverWait waits;

	public POM_CandRegister(WebDriver driver) {

		this.driver= driver;
		this.waits= new WebDriverWait(driver, Duration.ofSeconds(10));

	}

	private By RegisterBtn = By.xpath("//p[@class=\"sub-title\"]//following::a[contains(text(), 'Register')]");
	private By eCandEmail = By.xpath("//input[@id='emailInput']");
	private By verifyBtn = By.xpath("//button[@id='verifyBtn']");
	private By selectTitle = By.xpath("//select[@id='Input_SalutationTitle']");
	
	//select[@id='Input_SalutationTitle']
	
	

	
	public void clkRegButton() {

		@NonNull
		WebElement clkR = waits.until(ExpectedConditions.visibilityOfElementLocated(RegisterBtn));
		clkR.click();
	}

	public void enterCandEmail(String candEmail) {

		@NonNull
		WebElement candE = waits.until(ExpectedConditions.visibilityOfElementLocated(eCandEmail));
		candE.sendKeys(candEmail);
	}

	public void clkVerify() {

		@NonNull
		WebElement clkV = waits.until(ExpectedConditions.visibilityOfElementLocated(verifyBtn));
		clkV.click();
	}
	
	public void selectTitle(WebElement element, String Tvalue) {
		
		WebElement sltTitle = waits.until(ExpectedConditions.visibilityOfElementLocated(selectTitle));
		Select selectOp= new Select(sltTitle);
		
		selectOp.selectByValue(Tvalue);
		
	}
	
	
	
}
