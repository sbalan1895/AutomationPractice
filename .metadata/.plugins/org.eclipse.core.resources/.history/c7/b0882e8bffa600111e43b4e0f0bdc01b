package com.selenium1;

import java.time.Duration;

import org.openqa.selenium.Alert;
import org.openqa.selenium.By;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;
import org.testng.Assert;
import org.testng.annotations.Test;

import com.baseselenium.BaseCodekru;

public class AlertCodekru extends BaseCodekru {
	
	//button[text()='Show Alert']
	Alert alert;
	
	@Test(priority=1, enabled= true)
	public void SmplA() {
		
		WebElement smplA = driver.findElement(By.xpath("//button[text()='Show Alert']"));
		smplA.click();
		
		alert = driver.switchTo().alert();
		
		String altertext = alert.getText();
		System.out.println(altertext);
		
		alert.accept();
	}
	
	@Test(priority=2)
	public void cnfrmAlt() {
		
		WebElement clkcnfAl = waits.until(ExpectedConditions.elementToBeClickable(By.xpath("//button[text()='Show Confirm']")));
		clkcnfAl.click();
		
		alert= waits.until(ExpectedConditions.alertIsPresent());
		
		String textCnfP = alert.getText();
		System.out.println("Confirm Alert text: " +textCnfP);
		
		alert.accept();
		
		WebElement confirmRslt = waits.until(ExpectedConditions.visibilityOfElementLocated(By.xpath("//p[@id='confirmResult']")));
		String rsltT = confirmRslt.getText();
		
		System.out.println("ConfimPopup Result text: " +rsltT);
		
		Assert.assertEquals(rsltT, "You clicked: OK");
		
	}
	
	@Test(priority=3)
	public void prmptAl() {
		
		WebElement clkprmpAl = waits.until(ExpectedConditions.elementToBeClickable(By.xpath("//button[text()='Show Prompt']")));
		clkprmpAl.click();
		
		alert= waits.until(ExpectedConditions.alertIsPresent());
			
		String textPrmpAl = alert.getText();
		
		System.out.println("Prompt Alert text: " +textPrmpAl);
		
		alert.sendKeys("Testkru");
		
		alert.accept();
		
		WebElement prmpRslt = waits.until(ExpectedConditions.visibilityOfElementLocated(By.xpath("//p[contains(text(),'You entered:')]")));
		String rsltP = prmpRslt.getText();
		
		System.out.println("PromptAlert Result text: " +rsltP);
		
		Assert.assertEquals(rsltP, "You entered:Testkru");
		
	}
	
	@Test(priority=4)
	public void OpenModal() {
		
		waits.until(ExpectedConditions.visibilityOfElementLocated(By.xpath("//button[text()='Open Modal']"))).click();
		
		
		WebElement openModal = waits.until(ExpectedConditions.visibilityOfElementLocated((By.xpath("//div[contains(@class,'modal-content text-dark')]"))));
//		openModal.click();
		
		//div[contains(@class,'modal-content text-dark')]//input
		WebElement enterTxt = driver.findElement(By.xpath("//div[contains(@class,'modal-content text-dark')]//input"));
		enterTxt.sendKeys("testPopup");
		
		WebElement clkSaveCh = driver.findElement(By.xpath("//div[contains(@class,'modal-content text-dark')]//div/button[text()='Save changes']"));
		clkSaveCh.click();
	}

}
