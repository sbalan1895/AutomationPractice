package com.selenium1;

import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebElement;
import org.testng.annotations.Test;

import com.baseselenium.BaseSelenium;

public class WebTable extends BaseSelenium{

	@Test(priority=1)
	public void tableTitle() {

		List<WebElement> elements = driver.findElements(By.xpath("//table//thead//tr/th"));

		for(WebElement allE: elements) {
			System.out.println("Table title " +allE.getText());
		}

	}

	@Test(priority=2)
	public void getTableData() {

		List<WebElement> tableData = driver.findElements(By.xpath("//table[@class='table table-striped mt-3']"));

		for(WebElement entierData: tableData) {

			System.out.println("Entier table data " +entierData.getText());
		}

	}

	@Test(priority=3)
	public void getSalary() {

		List<WebElement> salaryClmn = driver.findElements(By.xpath("//tbody//tr//td[5]"));

		for (WebElement salaryData : salaryClmn) {

			System.out.println("Salary column data " +salaryData.getText());	
		}
	}

	@Test
	public void LNclmn() {
		List<WebElement> LNclmn = driver.findElements(By.xpath("//tbody//tr//td[2]"));

		for(WebElement getLN: LNclmn) {
			System.out.println("LastName column data "+ getLN);
		}

	}

}
