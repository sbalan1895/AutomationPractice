package com.selenium1;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.testng.annotations.BeforeClass;

import com.baseselenium.BaseSelenium;

public class XpathPractice {
	
	WebDriver driver;
	
	public static void main(String[] args) {
		
		BaseSelenium baseSel = new BaseSelenium();
		
		baseSel.loginSelenium();
	}
	
	public void xpath() {
		//td[text(),'kierra@example.com']
		
		WebElement kEmail = driver.findElement(By.xpath("//td[text(),'kierra@example.com']"));
		String text = kEmail.getText();
		System.out.println(text);
	}

}
